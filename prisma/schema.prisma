generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  ADMINISTRATOR
  EDITOR
}

enum CmsDraftStatus {
  DRAFT
  WAITING_FOR_APPROVAL
  RETURNED_FOR_CHANGES
  PUBLISHED
  WITHDRAWN
  ARCHIVED
}

enum CmsDraftKind {
  SITE_NOTICE
  NEWS
  FAQ
  FORM_DOCUMENT
  HERO
  MEDIA
  PAGE_CONTENT
}

enum CmsDraftOperation {
  CREATE
  UPDATE
  REMOVE
  REPLACE
  REORDER
  TOGGLE
  UPLOAD
  RETIRE
}

model Tenant {
  id          String            @id @default(cuid())
  slug        String            @unique
  displayName String
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  domains     TenantDomain[]
  settings    TenantSettings?
  staff       StaffMembership[]
  auditLogs   AuditLog[]
  siteNotices SiteNotice[]
  heroSlides HomeHeroSlide[]
  highlights HomeHighlight[]
  homeSettings HomeSettings?
  services Service[]
  forms FormDocument[]
  newsNotices NewsNotice[]
  faqs FAQ[]
  contactSettings ContactSettings?
  mediaAssets MediaAsset[]
  cmsDrafts   CmsDraft[] @relation("DraftTenant")
  pageContent PageContent[]
  leaders     LeadershipRecord[]
  rateFees    RateFee[]
  calculatorSettings CalculatorSettings?
  contactSubmissions ContactSubmission[]
  contactRateLimits ContactRateLimit[]

  @@map("tenants")
}

model TenantDomain {
  id        String   @id @default(cuid())
  tenantId  String
  hostname  String   @unique
  isPrimary Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, isActive])
  @@map("tenant_domains")
}

model TenantSettings {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  organisationName String
  memberAppStatus String   @default("COMING_SOON")
  memberAppUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_settings")
}

model User {
  id            String            @id
  name          String
  email         String            @unique
  emailVerified Boolean           @default(false)
  image         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   StaffMembership[]
  auditActions  AuditLog[]        @relation("AuditActor")
  mediaUploads  MediaAsset[]      @relation("MediaCreator")
  createdDrafts CmsDraft[]       @relation("DraftCreator")
  publishedDrafts CmsDraft[]     @relation("DraftPublisher")
  assignedDrafts CmsDraft[]      @relation("DraftAssignee")

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model StaffMembership {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  role      StaffRole
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([tenantId, role, isActive])
  @@map("staff_memberships")
}

model AuditLog {
  id             String   @id @default(cuid())
  tenantId       String
  actorUserId    String?
  action         String
  targetType     String
  targetId       String?
  changeMetadata Json?
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor          User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

model StaffLoginAttempt {
  id          String   @id @default(cuid())
  key         String   @unique
  email       String   @db.VarChar(320)
  ipAddress   String?  @db.VarChar(80)
  failures    Int      @default(0)
  windowStart DateTime @default(now())
  blockedUntil DateTime?
  updatedAt   DateTime @updatedAt
  @@index([email, ipAddress])
  @@map("staff_login_attempts")
}

model SiteNotice {
  id          String   @id @default(cuid())
  tenantId    String
  message     String   @db.VarChar(280)
  actionText  String?  @db.VarChar(80)
  actionUrl   String?  @db.VarChar(500)
  isEnabled   Boolean  @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@unique([tenantId])
  @@index([tenantId, isEnabled, startsAt, endsAt])
  @@map("site_notices")
}

model HomeHeroSlide {
  id          String   @id @default(cuid())
  tenantId    String
  mediaAssetId String?
  altText     String   @db.VarChar(200)
  sortOrder   Int      @default(0)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  mediaAsset  MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  @@index([tenantId, isEnabled, sortOrder])
  @@index([tenantId, mediaAssetId])
  @@map("home_hero_slides")
}

model HomeHighlight {
  id        String   @id @default(cuid())
  tenantId  String
  value     String   @db.VarChar(80)
  label     String   @db.VarChar(120)
  sortOrder Int      @default(0)
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId, isEnabled, sortOrder])
  @@map("home_highlights")
}

model HomeSettings {
  id             String   @id @default(cuid())
  tenantId       String
  memberAppLabel String   @default("Member App — Coming Soon")
  memberAppEnabled Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@unique([tenantId])
  @@map("home_settings")
}

model Service {
  id          String   @id @default(cuid())
  tenantId    String
  title       String   @db.VarChar(120)
  description String   @db.VarChar(500)
  icon        String   @db.VarChar(40)
  sortOrder   Int      @default(0)
  isEnabled   Boolean  @default(true)
  destination String?  @db.VarChar(200)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId, isEnabled, sortOrder])
  @@map("services")
}

model FormDocument {
  id           String   @id @default(cuid())
  tenantId     String
  title        String   @db.VarChar(160)
  description  String?  @db.VarChar(500)
  mediaAssetId String?
  sortOrder    Int      @default(0)
  isEnabled    Boolean  @default(true)
  category     String?  @db.VarChar(50)
  isAnnualReport Boolean @default(false)
  publicApprovedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  @@index([tenantId, isEnabled, sortOrder])
  @@map("form_documents")
}

model NewsNotice {
  id          String   @id @default(cuid())
  tenantId    String
  title       String   @db.VarChar(180)
  summary     String   @db.VarChar(600)
  publishedAt DateTime?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId, isPublished, publishedAt])
  @@map("news_notices")
}

model FAQ {
  id        String   @id @default(cuid())
  tenantId  String
  question  String   @db.VarChar(240)
  answer    String   @db.VarChar(1200)
  sortOrder Int      @default(0)
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId, isEnabled, sortOrder])
  @@map("faqs")
}

model ContactSettings {
  id             String   @id @default(cuid())
  tenantId       String
  organisationName String  @db.VarChar(160)
  streetAddress  String   @db.VarChar(240)
  postalAddress  String   @db.VarChar(240)
  telephone      String   @db.VarChar(80)
  publicEmail    String   @db.VarChar(160)
  officeHours    String?  @db.VarChar(300)
  directionsUrl  String?  @db.VarChar(500)
  notificationRecipients Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@unique([tenantId])
  @@map("contact_settings")
}

model MediaAsset {
  id               String    @id @default(cuid())
  tenantId         String
  objectKey        String    @unique
  originalFilename String    @db.VarChar(255)
  mimeType         String    @db.VarChar(80)
  purpose          String    @db.VarChar(40)
  byteSize         Int
  width            Int
  height           Int
  altText          String?   @db.VarChar(200)
  createdBy        String?
  retiredAt        DateTime?
  replacedById     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creator          User?     @relation("MediaCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  replacedBy       MediaAsset? @relation("MediaReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replacements     MediaAsset[] @relation("MediaReplacement")
  cmsDrafts        CmsDraft[] @relation("DraftMedia")
  heroSlides       HomeHeroSlide[]
  formDocuments    FormDocument[]
  pageContent      PageContent[]
  leadershipRecords LeadershipRecord[]
  @@index([tenantId, purpose, retiredAt])
  @@index([tenantId, createdAt])
  @@index([createdBy])
  @@map("media_assets")
}

model CmsDraft {
  id            String           @id @default(cuid())
  tenantId      String
  kind          CmsDraftKind
  operation     CmsDraftOperation
  status        CmsDraftStatus   @default(DRAFT)
  targetId      String?
  payload       Json
  mediaAssetId  String?
  createdBy     String
  assignedTo    String?
  administratorNote String?      @db.VarChar(500)
  submittedAt   DateTime?
  returnedAt    DateTime?
  withdrawnAt   DateTime?
  archivedAt    DateTime?
  revision      Int              @default(0)
  publishedBaseVersion Int?
  publishedBaseFingerprint String? @db.VarChar(128)
  publishedBy   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  publishedAt   DateTime?
  tenant        Tenant           @relation("DraftTenant", fields: [tenantId], references: [id], onDelete: Restrict)
  creator       User             @relation("DraftCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  assignee      User?            @relation("DraftAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  publisher     User?            @relation("DraftPublisher", fields: [publishedBy], references: [id], onDelete: SetNull)
  mediaAsset    MediaAsset?      @relation("DraftMedia", fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, kind, targetId, status])
  @@index([createdBy, status])
  @@index([mediaAssetId])
  @@index([tenantId, assignedTo, status])
  @@map("cms_drafts")
}

model PageContent {
  id String @id @default(cuid())
  tenantId String
  slot String @db.VarChar(60)
  heading String? @db.VarChar(180)
  body String? @db.VarChar(8000)
  mediaAssetId String?
  isPublished Boolean @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  @@unique([tenantId, slot])
  @@index([tenantId, isPublished, slot])
  @@map("page_content")
}

model LeadershipRecord {
  id String @id @default(cuid())
  tenantId String
  name String @db.VarChar(160)
  title String @db.VarChar(160)
  profile String? @db.VarChar(1000)
  group String @db.VarChar(80)
  mediaAssetId String?
  sortOrder Int @default(0)
  isEnabled Boolean @default(true)
  isPublished Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  @@index([tenantId, group, isPublished, isEnabled, sortOrder])
  @@map("leadership_records")
}

model RateFee {
  id String @id @default(cuid())
  tenantId String
  category String @db.VarChar(40)
  product String @db.VarChar(120)
  label String @db.VarChar(160)
  displayValue String @db.VarChar(120)
  note String? @db.VarChar(500)
  effectiveAt DateTime?
  sortOrder Int @default(0)
  isEnabled Boolean @default(true)
  isPublished Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId, isPublished, isEnabled, sortOrder])
  @@map("rate_fees")
}

model CalculatorSettings {
  id String @id @default(cuid())
  tenantId String @unique
  status String @default("AWAITING_SWCU_CONFIGURATION") @db.VarChar(60)
  disclaimer String @default("Repayment figures are estimates only. Actual repayments, terms and loan approval are subject to SWCU requirements and approval.") @db.VarChar(300)
  securityReminder String @default("SWCU will never ask you to disclose your password, PIN or security/verification code by email, phone, chat or through an unsolicited link. If you are unsure, contact SWCU using the contact details published on this website.") @db.VarChar(500)
  isEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@map("calculator_settings")
}

enum ContactSubmissionStatus {
  NEW
  BEING_HANDLED
  CLOSED
}

model ContactSubmission {
  id String @id @default(cuid())
  tenantId String
  reference String @db.VarChar(30)
  name String @db.VarChar(160)
  email String @db.VarChar(320)
  phone String? @db.VarChar(80)
  subject String @db.VarChar(40)
  message String @db.VarChar(4000)
  status ContactSubmissionStatus @default(NEW)
  internalNote String? @db.VarChar(1000)
  submittedAt DateTime @default(now())
  viewedAt DateTime?
  handledAt DateTime?
  closedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@unique([tenantId, reference])
  @@index([tenantId, status, submittedAt])
  @@map("contact_submissions")
}

model ContactRateLimit {
  id String @id @default(cuid())
  key String @unique
  tenantId String
  ipAddress String? @db.VarChar(80)
  windowStart DateTime @default(now())
  attempts Int @default(0)
  blockedUntil DateTime?
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId, ipAddress])
  @@map("contact_rate_limits")
}