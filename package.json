{
  "name": "swcu-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "next build",
    "prebuild": "prisma generate",
    "postinstall": "prisma generate",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "check:r2": "tsx scripts/check-r2.ts",
    "check:media": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-media.ts",
    "check:cms-workflow": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-cms-workflow.ts",
    "check:prompt3a": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-prompt3a.ts",
    "check:prompt3b": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-prompt3b.ts",
    "check:prompt3b:http": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-prompt3b-http.ts",
    "check:release-corrections": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-release-corrections.ts",
    "check:contact-map-generation": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-contact-map-generation.ts",
    "check:seed-safety": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-seed-safety.ts",
    "check:qa-residue": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-qa-residue.ts",
    "check:rich-text": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-rich-text.ts",
    "check:owner-uat": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-owner-uat.ts",
    "check:prompt4b": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-prompt4b.ts",
    "check:content-closure": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-content-closure.ts",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "check:tenant": "tsx scripts/check-tenant.ts",
    "bootstrap:admin": "NODE_OPTIONS=--conditions=react-server tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@better-auth/prisma-adapter": "1.7.5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@types/sanitize-html": "2.16.1",
    "better-auth": "1.7.5",
    "dotenv": "17.4.2",
    "lucide-react": "1.47.0",
    "motion": "13.4.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.17.7",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
